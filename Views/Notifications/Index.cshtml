@using DoughDoodle.Models.ViewModels
@model NotificationsViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-bell-fill text-primary"></i> Notifications</h1>
                    <p class="text-muted mb-0">Stay updated with your financial activities</p>
                </div>
                <div>
                    @if (Model.UnreadCount > 0)
                    {
                        <button class="btn btn-outline-primary me-2" onclick="markAllAsRead()">
                            <i class="bi bi-check2-all"></i> Mark All as Read
                        </button>
                    }
                    <span class="badge bg-primary fs-6">@Model.UnreadCount unread</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Notifications.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.Notifications)
                            {
                                <div class="list-group-item @(!notification.IsRead ? "bg-light" : "") notification-item" data-id="@notification.Id">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="notification-icon me-3">
                                                    @switch (notification.Type)
                                                    {
                                                        case DoughDoodle.Models.NotificationType.BudgetAlert:
                                                            <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                                                            break;
                                                        case DoughDoodle.Models.NotificationType.GoalAchievement:
                                                            <i class="bi bi-trophy-fill text-success fs-4"></i>
                                                            break;
                                                        case DoughDoodle.Models.NotificationType.GoalReminder:
                                                            <i class="bi bi-target text-info fs-4"></i>
                                                            break;
                                                        case DoughDoodle.Models.NotificationType.ScheduledTransactionDue:
                                                            <i class="bi bi-calendar-event-fill text-primary fs-4"></i>
                                                            break;
                                                        case DoughDoodle.Models.NotificationType.MonthlyReport:
                                                            <i class="bi bi-file-text-fill text-secondary fs-4"></i>
                                                            break;
                                                        case DoughDoodle.Models.NotificationType.SecurityAlert:
                                                            <i class="bi bi-shield-exclamation text-danger fs-4"></i>
                                                            break;
                                                        default:
                                                            <i class="bi bi-info-circle-fill text-info fs-4"></i>
                                                            break;
                                                    }
                                                </div>
                                                <div>
                                                    <h6 class="mb-1 @(!notification.IsRead ? "fw-bold" : "")">@notification.Title</h6>
                                                    <span class="badge badge-priority-@notification.Priority.ToString().ToLower()">
                                                        @notification.Priority
                                                    </span>
                                                    <span class="badge bg-light text-muted ms-1">
                                                        @notification.Type.ToString().Replace("_", " ")
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="mb-2 text-muted">@notification.Message</p>
                                            <div class="d-flex align-items-center justify-content-between">
                                                <small class="text-muted">
                                                    <i class="bi bi-clock"></i>
                                                    @notification.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                                                    @if (notification.IsRead && notification.ReadAt.HasValue)
                                                    {
                                                        <span class="ms-2">• Read @notification.ReadAt.Value.ToString("MMM dd, yyyy")</span>
                                                    }
                                                </small>
                                                @if (!string.IsNullOrEmpty(notification.ActionUrl) && !string.IsNullOrEmpty(notification.ActionText))
                                                {
                                                    <a href="@notification.ActionUrl" class="btn btn-sm btn-outline-primary">
                                                        @notification.ActionText
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-muted" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                @if (!notification.IsRead)
                                                {
                                                    <li>
                                                        <button class="dropdown-item" onclick="markAsRead(@notification.Id)">
                                                            <i class="bi bi-check"></i> Mark as Read
                                                        </button>
                                                    </li>
                                                }
                                                <li>
                                                    <button class="dropdown-item text-danger" onclick="deleteNotification(@notification.Id)">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-bell-slash fs-1 text-muted mb-3"></i>
                        <h4 class="text-muted">No Notifications</h4>
                        <p class="text-muted">You're all caught up! Notifications will appear here when you have budget alerts, goal achievements, or other important updates.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .notification-item {
        transition: all 0.2s ease;
        border-left: 4px solid transparent;
    }
    
    .notification-item:not(.list-group-item.bg-light) {
        border-left-color: #e9ecef;
    }
    
    .notification-item.bg-light {
        border-left-color: #0d6efd;
    }
    
    .notification-item:hover {
        background-color: #f8f9fa !important;
    }
    
    .badge-priority-low {
        background-color: #6c757d;
    }
    
    .badge-priority-medium {
        background-color: #0d6efd;
    }
    
    .badge-priority-high {
        background-color: #fd7e14;
    }
    
    .badge-priority-critical {
        background-color: #dc3545;
    }
    
    .notification-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: rgba(0,0,0,0.05);
    }
</style>

<script>
    async function markAsRead(id) {
        try {
            const response = await fetch('/Notifications/MarkAsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(id)
            });
            
            if (response.ok) {
                const notificationItem = document.querySelector(`[data-id="${id}"]`);
                if (notificationItem) {
                    notificationItem.classList.remove('bg-light');
                    notificationItem.style.borderLeftColor = '#e9ecef';
                    
                    // Update the title to remove bold
                    const title = notificationItem.querySelector('h6');
                    if (title) {
                        title.classList.remove('fw-bold');
                    }
                    
                    // Remove the "Mark as Read" option from dropdown
                    const markAsReadBtn = notificationItem.querySelector('.dropdown-menu button[onclick*="markAsRead"]');
                    if (markAsReadBtn) {
                        markAsReadBtn.parentElement.remove();
                    }
                }
                
                // Update unread count
                updateUnreadCount();
            }
        } catch (error) {
            console.error('Error marking notification as read:', error);
            alert('Failed to mark notification as read. Please try again.');
        }
    }
    
    async function markAllAsRead() {
        try {
            const response = await fetch('/Notifications/MarkAllAsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            });
            
            if (response.ok) {
                location.reload(); // Refresh the page to show updated state
            }
        } catch (error) {
            console.error('Error marking all notifications as read:', error);
            alert('Failed to mark all notifications as read. Please try again.');
        }
    }
    
    async function deleteNotification(id) {
        if (!confirm('Are you sure you want to delete this notification?')) {
            return;
        }
        
        try {
            const response = await fetch('/Notifications/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(id)
            });
            
            if (response.ok) {
                const notificationItem = document.querySelector(`[data-id="${id}"]`);
                if (notificationItem) {
                    notificationItem.remove();
                    
                    // Check if there are no more notifications
                    const remainingItems = document.querySelectorAll('.notification-item');
                    if (remainingItems.length === 0) {
                        location.reload(); // Show the "no notifications" state
                    }
                }
                
                // Update unread count
                updateUnreadCount();
            }
        } catch (error) {
            console.error('Error deleting notification:', error);
            alert('Failed to delete notification. Please try again.');
        }
    }
    
    async function updateUnreadCount() {
        try {
            const response = await fetch('/Notifications/GetUnreadCount');
            if (response.ok) {
                const data = await response.json();
                const badge = document.querySelector('.badge.bg-primary.fs-6');
                if (badge) {
                    badge.textContent = `${data.count} unread`;
                }
                
                // Hide "Mark All as Read" button if no unread notifications
                if (data.count === 0) {
                    const markAllBtn = document.querySelector('button[onclick="markAllAsRead()"]');
                    if (markAllBtn) {
                        markAllBtn.style.display = 'none';
                    }
                }
            }
        } catch (error) {
            console.error('Error updating unread count:', error);
        }
    }
    
    // Auto-mark as read when notification is clicked (optional)
    document.querySelectorAll('.notification-item').forEach(item => {
        item.addEventListener('click', function(e) {
            // Don't auto-mark as read if clicking on dropdown or action buttons
            if (e.target.closest('.dropdown') || e.target.closest('button') || e.target.closest('a')) {
                return;
            }
            
            const id = this.dataset.id;
            const isUnread = this.classList.contains('bg-light');
            
            if (isUnread) {
                markAsRead(parseInt(id));
            }
        });
    });
</script>