@model DoughDoodle.Models.ViewModels.RecurringTransactionsViewModel
@{
    ViewData["Title"] = "Recurring Transactions";
    var pausedCount = Model.ScheduledTransactions.Count(st => !st.IsActive);
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-arrow-repeat"></i> Recurring Transactions</h1>
            <p class="text-muted mb-0">Schedule income and expenses so you never miss a due date.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Recurring Transaction
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Scheduled</div>
                    <div class="fs-3 fw-semibold">@Model.TotalScheduled</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Active</div>
                    <div class="fs-3 fw-semibold text-success">@Model.ActiveScheduled</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Due This Week</div>
                    <div class="fs-3 fw-semibold text-warning">@Model.DueCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Paused</div>
                    <div class="fs-3 fw-semibold text-secondary">@pausedCount</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.DueCount > 0)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Attention:</strong> You have @Model.DueCount recurring transaction(s) due within 7 days.
            Use Execute or Skip on each row below.
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-list-ul"></i> Your Recurring Transactions</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.ScheduledTransactions.Any())
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-arrow-repeat display-6 text-muted"></i>
                    <h5 class="mt-3">No recurring transactions yet</h5>
                    <p class="text-muted mb-3">Create your first scheduled income or expense.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Recurring Transaction
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Category</th>
                                <th>Frequency</th>
                                <th>Next Due</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.ScheduledTransactions)
                        {
                            var isDueSoon = item.IsActive && item.NextDueDate <= DateTime.Now.AddDays(7);
                            var isOverdue = item.IsActive && item.NextDueDate.Date < DateTime.Today;
                            var amountClass = item.TransactionType == DoughDoodle.Models.TransactionType.Income
                                ? "text-success"
                                : "text-danger";
                            var amountPrefix = item.TransactionType == DoughDoodle.Models.TransactionType.Income ? "" : "-";
                            <tr class="@(!item.IsActive ? "table-secondary" : "")">
                                <td>
                                    <strong>@item.Description</strong>
                                    @if (item.Account != null)
                                    {
                                        <br /><small class="text-muted">@item.Account.Name</small>
                                    }
                                </td>
                                <td>
                                    <span class="@amountClass">@amountPrefix@CurrencyDisplay.Format(item.Amount, ViewData["PreferredCurrency"] as string)</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@(item.Category?.Name ?? "Uncategorized")</span>
                                </td>
                                <td>@item.RecurrenceType@(item.RecurrenceInterval > 1 ? $" (every {item.RecurrenceInterval})" : "")</td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="text-danger">@item.NextDueDate.ToString("MMM dd, yyyy")</span>
                                    }
                                    else if (isDueSoon)
                                    {
                                        <span class="text-warning">@item.NextDueDate.ToString("MMM dd, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>@item.NextDueDate.ToString("MMM dd, yyyy")</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary">Paused</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                    else if (isDueSoon)
                                    {
                                        <span class="badge bg-warning text-dark">Due Soon</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (item.IsActive)
                                        {
                                            <form asp-action="Execute" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-success" title="Execute">
                                                    <i class="bi bi-play-fill"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Skip" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-warning" title="Skip">
                                                    <i class="bi bi-skip-forward"></i>
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleActive" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-secondary" title="@(item.IsActive ? "Pause" : "Resume")">
                                                <i class="bi @(item.IsActive ? "bi-pause" : "bi-play")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this recurring transaction?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
