@model DoughDoodle.Models.ScheduledTransaction
@{
    ViewData["Title"] = "Add Recurring Transaction";
    var categories = ViewBag.Categories as List<DoughDoodle.Models.Category> ?? new List<DoughDoodle.Models.Category>();
    var accounts = ViewBag.Accounts as List<DoughDoodle.Models.Account> ?? new List<DoughDoodle.Models.Account>();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-plus-circle"></i> Add Recurring Transaction</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <input asp-for="Description" class="form-control" placeholder="e.g., Rent, Salary, Netflix" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Amount" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="Amount" class="form-control" />
                                    </div>
                                    <span asp-validation-for="Amount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TransactionType" class="form-label"></label>
                                    <select asp-for="TransactionType" class="form-select"
                                            asp-items="Html.GetEnumSelectList<DoughDoodle.Models.TransactionType>()"></select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CategoryId" class="form-label">Category</label>
                                    <select asp-for="CategoryId" class="form-select" required>
                                        <option value="">Select category...</option>
                                        @foreach (var category in categories)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AccountId" class="form-label">Account (optional)</label>
                                    <select asp-for="AccountId" class="form-select">
                                        <option value="">None</option>
                                        @foreach (var account in accounts)
                                        {
                                            <option value="@account.Id">@account.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="RecurrenceType" class="form-label"></label>
                                    <select asp-for="RecurrenceType" class="form-select"
                                            asp-items="Html.GetEnumSelectList<DoughDoodle.Models.RecurrenceType>()"></select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="RecurrenceInterval" class="form-label">Every N periods</label>
                                    <input asp-for="RecurrenceInterval" class="form-control" min="1" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="StartDate" class="form-label"></label>
                                    <input asp-for="StartDate" type="date" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EndDate" class="form-label">End Date (optional)</label>
                                    <input asp-for="EndDate" type="date" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 form-check mt-4">
                                    <input asp-for="AutoExecute" class="form-check-input" />
                                    <label asp-for="AutoExecute" class="form-check-label">Mark for auto-execute</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
