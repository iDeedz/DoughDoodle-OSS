@model DoughDoodle.Models.InvestmentAccount
@{
    ViewData["Title"] = "Add Investment Account";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-plus-circle"></i> Add Investment Account</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">Account Name *</label>
                                    <input asp-for="Name" class="form-control" placeholder="e.g., 401(k), Brokerage" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InvestmentType" class="form-label">Investment Type *</label>
                                    <select asp-for="InvestmentType" class="form-select" asp-items="Html.GetEnumSelectList<DoughDoodle.Models.InvestmentType>()"></select>
                                    <span asp-validation-for="InvestmentType" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CurrentValue" class="form-label">Current Value *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="CurrentValue" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="CurrentValue" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CostBasis" class="form-label">Cost Basis *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="CostBasis" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="CostBasis" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InstitutionName" class="form-label">Institution</label>
                                    <input asp-for="InstitutionName" class="form-control" placeholder="e.g., Fidelity, Vanguard" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AccountNumber" class="form-label">Account Number</label>
                                    <input asp-for="AccountNumber" class="form-control" placeholder="Last 4 digits recommended" />
                                    <div class="form-text">For identification purposes (last 4 digits recommended)</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief description of this investment account"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Personal notes or reminders"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Portfolio
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Create Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
