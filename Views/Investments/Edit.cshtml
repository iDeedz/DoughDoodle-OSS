@model DoughDoodle.Models.InvestmentAccount
@{
    ViewData["Title"] = "Edit Investment Account";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-pencil"></i> Edit Investment Account</h4>
                    <a asp-action="AddHolding" asp-route-accountId="@Model.Id" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-plus-circle"></i> Add Holding
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InvestmentType" class="form-label"></label>
                                    <select asp-for="InvestmentType" class="form-select"
                                            asp-items="Html.GetEnumSelectList<DoughDoodle.Models.InvestmentType>()"></select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CurrentValue" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="CurrentValue" class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CostBasis" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="CostBasis" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="InstitutionName" class="form-label"></label>
                                    <input asp-for="InstitutionName" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AccountNumber" class="form-label"></label>
                                    <input asp-for="AccountNumber" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Portfolio
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Holdings</h5>
                </div>
                <div class="card-body">
                    @if (Model.Holdings == null || !Model.Holdings.Any())
                    {
                        <p class="text-muted mb-0">No holdings yet. Add individual positions to track performance.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Symbol</th>
                                        <th>Name</th>
                                        <th>Qty</th>
                                        <th>Avg Cost</th>
                                        <th>Price</th>
                                        <th>Value</th>
                                        <th>Gain/Loss</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var holding in Model.Holdings)
                                    {
                                        <tr>
                                            <td><strong>@holding.Symbol</strong></td>
                                            <td>@holding.Name</td>
                                            <td>@holding.Quantity.ToString("N4")</td>
                                            <td>@CurrencyDisplay.Format(holding.AverageCost, ViewData["PreferredCurrency"] as string)</td>
                                            <td>@CurrencyDisplay.Format(holding.CurrentPrice, ViewData["PreferredCurrency"] as string)</td>
                                            <td>@CurrencyDisplay.Format(holding.TotalValue, ViewData["PreferredCurrency"] as string)</td>
                                            <td class="@(holding.GainLoss >= 0 ? "text-success" : "text-danger")">
                                                @CurrencyDisplay.Format(holding.GainLoss, ViewData["PreferredCurrency"] as string) (@holding.GainLossPercentage%)
                                            </td>
                                            <td>
                                                <form asp-action="DeleteHolding" method="post" onsubmit="return confirm('Remove this holding?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@holding.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
