@model DoughDoodle.Models.PortfolioHolding
@{
    ViewData["Title"] = "Add Holding";
    var accountId = (int)(ViewBag.AccountId ?? 0);
    var accountName = ViewBag.AccountName as string ?? "Account";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-plus-circle"></i> Add Holding to @accountName</h4>
                </div>
                <div class="card-body">
                    <form asp-action="AddHolding" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" name="InvestmentAccountId" value="@accountId" />

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Symbol" class="form-label"></label>
                                    <input asp-for="Symbol" class="form-control" placeholder="e.g., AAPL" maxlength="10" />
                                    <span asp-validation-for="Symbol" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" placeholder="e.g., Apple Inc." />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label"></label>
                                    <input asp-for="Quantity" class="form-control" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="AverageCost" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="AverageCost" class="form-control" />
                                    </div>
                                    <span asp-validation-for="AverageCost" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CurrentPrice" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="CurrentPrice" class="form-control" />
                                    </div>
                                    <span asp-validation-for="CurrentPrice" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@accountId" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Add Holding
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
