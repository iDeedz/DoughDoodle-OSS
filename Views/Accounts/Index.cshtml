@model List<DoughDoodle.Models.Account>
@using DoughDoodle.Models
@{
    ViewData["Title"] = "Accounts";
    var onBudgetTotal = (decimal)(ViewBag.OnBudgetTotal ?? 0m);
    var offBudgetTotal = (decimal)(ViewBag.OffBudgetTotal ?? 0m);
    var netWorth = (decimal)(ViewBag.NetWorth ?? 0m);
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-wallet2"></i> Accounts</h2>
            <p class="text-muted mb-0">Manage your on-budget and off-budget accounts</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Account
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">On-Budget Total</h6>
                    <h3 class="text-primary mb-0">@CurrencyDisplay.Format(onBudgetTotal, ViewData["PreferredCurrency"] as string)</h3>
                    <small class="text-muted">Active on-budget accounts</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Off-Budget Total</h6>
                    <h3 class="text-secondary mb-0">@CurrencyDisplay.Format(offBudgetTotal, ViewData["PreferredCurrency"] as string)</h3>
                    <small class="text-muted">Active off-budget accounts</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Net Worth</h6>
                    <h3 class="text-success mb-0">@CurrencyDisplay.Format(netWorth, ViewData["PreferredCurrency"] as string)</h3>
                    <small class="text-muted">All active accounts</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-list"></i> All Accounts</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Balance</th>
                                <th>Budget</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model)
                            {
                                <tr class="@(!account.IsActive ? "table-secondary" : "")">
                                    <td>
                                        <strong>@account.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(account.Notes))
                                        {
                                            <br><small class="text-muted">@account.Notes</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@account.AccountType</span>
                                    </td>
                                    <td>
                                        <strong class="@(account.Balance < 0 ? "text-danger" : "")">@CurrencyDisplay.Format(account.Balance, ViewData["PreferredCurrency"] as string)</strong>
                                    </td>
                                    <td>
                                        @if (account.IsOnBudget)
                                        {
                                            <span class="badge bg-primary">On-Budget</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Off-Budget</span>
                                        }
                                    </td>
                                    <td>
                                        @if (account.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">Closed</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm flex-wrap">
                                            <a asp-action="Edit" asp-route-id="@account.Id" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            @if (account.IsActive)
                                            {
                                                <a asp-action="UpdateBalance" asp-route-id="@account.Id" class="btn btn-outline-secondary" title="Update Balance">
                                                    <i class="bi bi-cash-stack"></i> Balance
                                                </a>
                                                <a asp-action="Reconcile" asp-route-id="@account.Id" class="btn btn-outline-info" title="Reconcile">
                                                    <i class="bi bi-check2-square"></i> Reconcile
                                                </a>
                                                <button type="button" class="btn btn-outline-danger"
                                                        onclick="openCloseModal(@account.Id, '@account.Name.Replace("'", "\\'")', @account.Balance)"
                                                        title="Close Account">
                                                    <i class="bi bi-x-circle"></i> Close
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-action="Reopen" asp-route-id="@account.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success" title="Reopen Account"
                                                            onclick="return confirm('Reopen account \'@account.Name\'?');">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Reopen
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-wallet2 display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No Accounts Yet</h4>
                    <p class="text-muted">Add your first account to start tracking balances and transactions.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Your First Account
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Close Account Modal -->
<div class="modal fade" id="closeAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="closeAccountForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-circle text-danger"></i> Close Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to close <strong id="closeAccountName"></strong>?</p>
                    <div id="closeBalanceWarning" class="alert alert-warning d-none">
                        <i class="bi bi-exclamation-triangle"></i>
                        This account has a balance of <strong id="closeAccountBalance"></strong>.
                        Optionally transfer the balance to another account before closing.
                    </div>
                    <div id="transferAccountGroup" class="mb-3 d-none">
                        <label for="transferToAccountId" class="form-label">Transfer balance to (optional)</label>
                        <select name="transferToAccountId" id="transferToAccountId" class="form-select">
                            <option value="">Do not transfer (zero out balance)</option>
                            @foreach (var account in Model.Where(a => a.IsActive))
                            {
                                <option value="@account.Id">@account.Name (@CurrencyDisplay.Format(account.Balance, ViewData["PreferredCurrency"] as string))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Close Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openCloseModal(accountId, accountName, balance) {
    document.getElementById('closeAccountForm').action = '@Url.Action("Close")/' + accountId;
    document.getElementById('closeAccountName').textContent = accountName;

    const warning = document.getElementById('closeBalanceWarning');
    const transferGroup = document.getElementById('transferAccountGroup');
    const balanceEl = document.getElementById('closeAccountBalance');
    const transferSelect = document.getElementById('transferToAccountId');

    if (balance !== 0) {
        warning.classList.remove('d-none');
        transferGroup.classList.remove('d-none');
        balanceEl.textContent = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(balance);

        Array.from(transferSelect.options).forEach(option => {
            option.hidden = option.value === String(accountId);
        });
    } else {
        warning.classList.add('d-none');
        transferGroup.classList.add('d-none');
        transferSelect.value = '';
    }

    new bootstrap.Modal(document.getElementById('closeAccountModal')).show();
}
</script>
}
