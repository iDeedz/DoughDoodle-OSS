@model DoughDoodle.Controllers.UpdateBalanceViewModel
@{
    ViewData["Title"] = "Update Balance";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-cash-stack"></i> Update Balance</h4>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateBalance" method="post">
                        <input type="hidden" asp-for="AccountId" />

                        <div class="mb-3">
                            <label asp-for="AccountName" class="form-label">Account</label>
                            <input asp-for="AccountName" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CurrentBalance" class="form-label">Current Balance</label>
                            <div class="input-group">
                                <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                <input asp-for="CurrentBalance" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewBalance" class="form-label">New Balance *</label>
                            <div class="input-group">
                                <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                <input asp-for="NewBalance" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="NewBalance" class="text-danger"></span>
                            <div class="form-text">Enter the corrected balance. A balance adjustment transaction will be created if the amount differs.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" placeholder="Reason for balance adjustment (optional)" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Accounts
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Update Balance
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
