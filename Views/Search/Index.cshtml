@model DoughDoodle.Models.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Advanced Search";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary mb-0">
                    <i class="bi bi-search"></i> Advanced Search
                </h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Search</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Search Form -->
    <form asp-action="Index" method="get" id="searchForm">
        <div class="card border-primary mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-funnel"></i> Search Filters
                </h5>
            </div>
            <div class="card-body bg-light">
                <div class="row g-3">
                    <!-- Search Query -->
                    <div class="col-md-6">
                        <label for="Query" class="form-label fw-semibold">Search Term</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>
                            <input asp-for="Query" class="form-control" 
                                   placeholder="Search transactions, categories, accounts..." />
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="col-md-3">
                        <label for="StartDate" class="form-label fw-semibold">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label for="EndDate" class="form-label fw-semibold">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>

                    <!-- Category Filter -->
                    <div class="col-md-4">
                        <label for="CategoryFilter" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryFilter" class="form-select">
                            <option value="">All Categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Name">@category.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Account Filter -->
                    <div class="col-md-4">
                        <label for="AccountFilter" class="form-label fw-semibold">Account</label>
                        <select asp-for="AccountFilter" class="form-select">
                            <option value="">All Accounts</option>
                            @foreach (var account in Model.Accounts)
                            {
                                <option value="@account.Name">@account.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Transaction Type -->
                    <div class="col-md-4">
                        <label for="TypeFilter" class="form-label fw-semibold">Transaction Type</label>
                        <select asp-for="TypeFilter" class="form-select">
                            <option value="">All Types</option>
                            <option value="@DoughDoodle.Models.TransactionType.Income">Income</option>
                            <option value="@DoughDoodle.Models.TransactionType.Expense">Expense</option>
                            <option value="@DoughDoodle.Models.TransactionType.Transfer">Transfer</option>
                        </select>
                    </div>

                    <!-- Amount Range -->
                    <div class="col-md-6">
                        <label for="MinAmount" class="form-label fw-semibold">Minimum Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                            <input asp-for="MinAmount" type="number" step="0.01" class="form-control" 
                                   placeholder="0.00" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="MaxAmount" class="form-label fw-semibold">Maximum Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                            <input asp-for="MaxAmount" type="number" step="0.01" class="form-control" 
                                   placeholder="0.00" />
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                            <i class="bi bi-x-circle"></i> Clear Filters
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="saveSearch()" title="Save this search">
                            <i class="bi bi-bookmark"></i> Save Search
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @if (Model.Results.Any() || !string.IsNullOrEmpty(Model.Query) || Model.TotalResults > 0)
    {
        <!-- Search Results -->
        <div class="card border-info">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-list-task"></i> Search Results
                    @if (Model.TotalResults > 0)
                    {
                        <span class="badge bg-primary ms-2">@Model.TotalResults result@(Model.TotalResults != 1 ? "s" : "")</span>
                    }
                </h5>
                @if (Model.Results.Any())
                {
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm btn-light" onclick="exportResults()" title="Export Results">
                            <i class="bi bi-download"></i>
                        </button>
                        <button class="btn btn-sm btn-light" onclick="bulkActions()" title="Bulk Actions">
                            <i class="bi bi-check2-square"></i>
                        </button>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model.Results.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-primary">
                                <tr>
                                    <th scope="col">
                                        <input type="checkbox" class="form-check-input" id="selectAll" onchange="toggleSelectAll(this)" />
                                    </th>
                                    <th scope="col">Date</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Account</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Amount</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in Model.Results)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input transaction-checkbox" 
                                                   value="@transaction.Id" />
                                        </td>
                                        <td>@transaction.Date.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @transaction.Description
                                                @if (!string.IsNullOrEmpty(transaction.Notes))
                                                {
                                                    <i class="bi bi-sticky ms-2 text-info" title="@transaction.Notes"></i>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (transaction.Category != null)
                                            {
                                                <span class="badge bg-info">@transaction.Category.Name</span>
                                            }
                                        </td>
                                        <td>
                                            @if (transaction.Account != null)
                                            {
                                                <span class="badge bg-light text-dark border">@transaction.Account.Name</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(transaction.TransactionType == DoughDoodle.Models.TransactionType.Income ? "bg-success" : 
                                                               transaction.TransactionType == DoughDoodle.Models.TransactionType.Expense ? "bg-danger" : "bg-warning")">
                                                @transaction.TransactionType
                                            </span>
                                        </td>
                                        <td class="@(transaction.TransactionType == DoughDoodle.Models.TransactionType.Income ? "text-success" : 
                                                   transaction.TransactionType == DoughDoodle.Models.TransactionType.Expense ? "text-danger" : "text-warning")">
                                            @(transaction.TransactionType == DoughDoodle.Models.TransactionType.Income ? "+" : 
                                              transaction.TransactionType == DoughDoodle.Models.TransactionType.Expense ? "-" : "")@CurrencyDisplay.Format(transaction.Amount, ViewData["PreferredCurrency"] as string)
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-controller="Home" asp-action="EditTransaction" asp-route-id="@transaction.Id" 
                                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-info" 
                                                        onclick="viewDetails(@transaction.Id)" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-warning" 
                                                        onclick="duplicateTransaction(@transaction.Id)" title="Duplicate">
                                                    <i class="bi bi-copy"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Search results pagination" class="mt-3">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@GetSearchUrl(Model.CurrentPage - 1)">
                                        <i class="bi bi-chevron-left"></i> Previous
                                    </a>
                                </li>
                                
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@GetSearchUrl(i)">@i</a>
                                    </li>
                                }
                                
                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@GetSearchUrl(Model.CurrentPage + 1)">
                                        Next <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }

                    <!-- Results Summary -->
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <small class="text-muted">
                                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalResults) 
                                of @Model.TotalResults results
                            </small>
                        </div>
                        <div class="col-md-6 text-end">
                            @if (Model.Results.Any())
                            {
                                <small class="text-muted">
                                    Total: <span class="@(Model.Results.Sum(r => r.Amount) >= 0 ? "text-success" : "text-danger")">
                                        @CurrencyDisplay.Format(Model.Results.Sum(r => r.TransactionType == DoughDoodle.Models.TransactionType.Income ? r.Amount : -r.Amount), ViewData["PreferredCurrency"] as string)
                                    </span>
                                </small>
                            }
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.Query) || Model.TotalResults == 0)
                {
                    <!-- No Results -->
                    <div class="text-center py-5">
                        <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
                        <h4 class="text-muted mt-3">No Results Found</h4>
                        <p class="text-muted">
                            Try adjusting your search criteria or 
                            <a href="#" onclick="clearFilters()" class="text-decoration-none">clear all filters</a>
                        </p>
                        <div class="mt-3">
                            <a asp-controller="Home" asp-action="AddTransaction" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Add New Transaction
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Welcome Message -->
        <div class="card border-success">
            <div class="card-body text-center py-5">
                <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-primary mt-3">Advanced Search</h4>
                <p class="text-muted mb-4">
                    Search through your transactions, categories, and accounts with powerful filtering options.
                </p>
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <div class="card bg-light border-primary">
                                    <div class="card-body text-center">
                                        <i class="bi bi-receipt text-primary" style="font-size: 2rem;"></i>
                                        <h6 class="text-primary mt-2 mb-1">Transactions</h6>
                                        <small class="text-muted">Search by description, amount, or date</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light border-success">
                                    <div class="card-body text-center">
                                        <i class="bi bi-tags text-success" style="font-size: 2rem;"></i>
                                        <h6 class="text-success mt-2 mb-1">Categories</h6>
                                        <small class="text-muted">Filter by budget categories</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light border-warning">
                                    <div class="card-body text-center">
                                        <i class="bi bi-bank text-warning" style="font-size: 2rem;"></i>
                                        <h6 class="text-warning mt-2 mb-1">Accounts</h6>
                                        <small class="text-muted">Search across all accounts</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light border-info">
                                    <div class="card-body text-center">
                                        <i class="bi bi-funnel text-info" style="font-size: 2rem;"></i>
                                        <h6 class="text-info mt-2 mb-1">Advanced Filters</h6>
                                        <small class="text-muted">Date ranges, amounts, and more</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetSearchUrl(int page)
    {
        var query = $"?CurrentPage={page}";
        if (!string.IsNullOrEmpty(Model.Query))
            query += $"&Query={Uri.EscapeDataString(Model.Query)}";
        if (Model.StartDate.HasValue)
            query += $"&StartDate={Model.StartDate.Value:yyyy-MM-dd}";
        if (Model.EndDate.HasValue)
            query += $"&EndDate={Model.EndDate.Value:yyyy-MM-dd}";
        if (!string.IsNullOrEmpty(Model.CategoryFilter))
            query += $"&CategoryFilter={Uri.EscapeDataString(Model.CategoryFilter)}";
        if (!string.IsNullOrEmpty(Model.AccountFilter))
            query += $"&AccountFilter={Uri.EscapeDataString(Model.AccountFilter)}";
        if (Model.TypeFilter.HasValue)
            query += $"&TypeFilter={Model.TypeFilter.Value}";
        if (Model.MinAmount.HasValue)
            query += $"&MinAmount={Model.MinAmount.Value}";
        if (Model.MaxAmount.HasValue)
            query += $"&MaxAmount={Model.MaxAmount.Value}";
        
        return query;
    }
}

@section Scripts {
    <script>
        function clearFilters() {
            document.getElementById('searchForm').reset();
            window.location.href = '@Url.Action("Index", "Search")';
        }

        function toggleSelectAll(checkbox) {
            const checkboxes = document.querySelectorAll('.transaction-checkbox');
            checkboxes.forEach(cb => cb.checked = checkbox.checked);
        }

        function exportResults() {
            const selectedIds = Array.from(document.querySelectorAll('.transaction-checkbox:checked'))
                .map(cb => cb.value);
            
            if (selectedIds.length === 0) {
                alert('Please select transactions to export.');
                return;
            }
            
            // Implement export functionality
            console.log('Export selected transactions:', selectedIds);
        }

        function bulkActions() {
            const selectedIds = Array.from(document.querySelectorAll('.transaction-checkbox:checked'))
                .map(cb => cb.value);
            
            if (selectedIds.length === 0) {
                alert('Please select transactions for bulk actions.');
                return;
            }
            
            // Show bulk actions modal or menu
            console.log('Bulk actions for transactions:', selectedIds);
        }

        function viewDetails(transactionId) {
            // Implement view details functionality
            console.log('View details for transaction:', transactionId);
        }

        function duplicateTransaction(transactionId) {
            if (confirm('Create a copy of this transaction?')) {
                // Implement duplicate functionality
                console.log('Duplicate transaction:', transactionId);
            }
        }

        function saveSearch() {
            const formData = new FormData(document.getElementById('searchForm'));
            const searchParams = Object.fromEntries(formData.entries());
            
            const searchName = prompt('Enter a name for this saved search:');
            if (searchName && searchName.trim()) {
                // Implement save search functionality
                console.log('Save search:', searchName, searchParams);
                alert('Search saved successfully!');
            }
        }

        // Auto-submit form on filter changes (optional)
        document.addEventListener('DOMContentLoaded', function() {
            const autoSubmitElements = ['CategoryFilter', 'AccountFilter', 'TypeFilter'];
            autoSubmitElements.forEach(id => {
                const element = document.getElementById(id);
                if (element) {
                    element.addEventListener('change', function() {
                        // Optional: auto-submit on filter change
                        // document.getElementById('searchForm').submit();
                    });
                }
            });
        });
    </script>
}