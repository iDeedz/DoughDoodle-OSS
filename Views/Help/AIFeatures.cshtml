                                                <small class="text-muted">→ Transportation (92% confidence)</small>
                                            </li>
                                            <li><strong>NETFLIX.COM</strong><br>
                                                <small class="text-muted">→ Entertainment (95% confidence)</small>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
