@{
    ViewData["Title"] = "FAQ";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-question-circle text-primary"></i> Frequently Asked Questions</h1>
                    <p class="text-muted mb-0">Common questions about DoughDoodle</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Back to Help
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>What is envelope budgeting?</h5>
                    <p>Envelope budgeting is a method where you allocate specific amounts of money to different spending categories (like physical envelopes with cash). DoughDoodle makes this digital and intelligent.</p>
                    
                    <h5 class="mt-4">How do I view my spending reports?</h5>
                    <p>Navigate to Reports from the main menu. You'll find overview reports and detailed trend analysis showing your spending patterns over time.</p>
                    
                    <h5 class="mt-4">Can I manage multiple users?</h5>
                    <p>Yes! Main accounts can create up to 5 sub-accounts for family members, with oversight capabilities while maintaining privacy.</p>
                    
                    <h5 class="mt-4">Is my financial data secure?</h5>
                    <p>Absolutely. DoughDoodle uses enterprise-grade security with complete user data isolation and secure authentication.</p>
                </div>
            </div>
        </div>
    </div>
</div>