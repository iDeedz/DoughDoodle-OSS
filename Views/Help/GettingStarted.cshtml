@{
    ViewData["Title"] = "Getting Started";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-play-circle text-primary"></i> Getting Started</h1>
                    <p class="text-muted mb-0">Your guide to setting up DoughDoodle</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Back to Help
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>Welcome to DoughDoodle!</h5>
                    <p>This quick start guide will help you set up your envelope budgeting system in minutes.</p>
                    
                    <h6 class="mt-4">Step 1: Create Your Budget Categories</h6>
                    <p>Start by creating envelope categories for your different spending areas like groceries, rent, entertainment, etc.</p>
                    
                    <h6 class="mt-4">Step 2: Set Your Budget Amounts</h6>
                    <p>Allocate money to each envelope based on your monthly income and priorities.</p>
                    
                    <h6 class="mt-4">Step 3: Record Transactions</h6>
                    <p>Add your income and expenses to track how much you're spending from each envelope.</p>
                    
                    <h6 class="mt-4">Step 4: Monitor Your Progress</h6>
                    <p>Use the Dashboard and Reports to see how you're doing and make adjustments as needed.</p>
                </div>
            </div>
        </div>
    </div>
</div>