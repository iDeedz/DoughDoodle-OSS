@model DoughDoodle.Models.FinancialGoal
@{
    ViewData["Title"] = "Edit Goal";
    var cc = CurrencyDisplay.Normalize(ViewData["PreferredCurrency"] as string);
    var curSym = CurrencyDisplay.Symbol(cc);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-pencil"></i> Edit Financial Goal</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="GoalType" class="form-label"></label>
                                    <select asp-for="GoalType" class="form-select"
                                            asp-items="Html.GetEnumSelectList<DoughDoodle.Models.GoalType>()"></select>
                                    <span asp-validation-for="GoalType" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TargetAmount" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@curSym</span>
                                        <input asp-for="TargetAmount" class="form-control" />
                                    </div>
                                    <span asp-validation-for="TargetAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CurrentAmount" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">@curSym</span>
                                        <input asp-for="CurrentAmount" class="form-control" />
                                    </div>
                                    <span asp-validation-for="CurrentAmount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TargetDate" class="form-label"></label>
                                    <input asp-for="TargetDate" type="date" class="form-control" />
                                    <span asp-validation-for="TargetDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 form-check mt-4">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Goals
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
