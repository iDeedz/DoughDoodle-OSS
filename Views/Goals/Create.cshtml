@model DoughDoodle.Models.FinancialGoal
@{
    ViewData["Title"] = "Create Financial Goal";
    var cc = CurrencyDisplay.Normalize(ViewData["PreferredCurrency"] as string);
    var curSym = CurrencyDisplay.Symbol(cc);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-plus-circle"></i> Create Financial Goal</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">Goal Name *</label>
                                    <input asp-for="Name" class="form-control" placeholder="e.g., Emergency Fund, Vacation" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="GoalType" class="form-label">Goal Type *</label>
                                    <select asp-for="GoalType" class="form-select" asp-items="Html.GetEnumSelectList<DoughDoodle.Models.GoalType>()"></select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TargetAmount" class="form-label">Target Amount *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">@curSym</span>
                                        <input asp-for="TargetAmount" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="TargetAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TargetDate" class="form-label">Target Date</label>
                                    <input asp-for="TargetDate" type="date" class="form-control" />
                                    <div class="form-text">Optional — when you want to reach this goal</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="What are you saving for?"></textarea>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsShared" class="form-check-input" type="checkbox" />
                                <label asp-for="IsShared" class="form-check-label">Share with household members</label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Goals
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Create Goal
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
