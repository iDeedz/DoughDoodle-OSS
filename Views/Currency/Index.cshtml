@model IEnumerable<DoughDoodle.Models.ExchangeRate>
@{ ViewData["Title"] = "Exchange rates"; }
<h2><i class="bi bi-currency-exchange"></i> Multi-currency rates</h2>
<p class="text-muted">Manual rates always work. Live API refresh only when <code>FxApi:ApiKey</code> is set.</p>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<form method="post" asp-action="Upsert" class="row g-2 mb-3">
  @Html.AntiForgeryToken()
  <div class="col-auto"><input name="baseCurrency" class="form-control" maxlength="3" value="USD" /></div>
  <div class="col-auto"><input name="quoteCurrency" class="form-control" maxlength="3" value="ZAR" /></div>
  <div class="col-auto"><input name="rate" type="number" step="0.000001" class="form-control" placeholder="Rate" required /></div>
  <div class="col-auto"><button class="btn btn-primary">Save manual rate</button></div>
</form>
<form method="post" asp-action="RefreshApi" class="mb-3">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">Refresh from API (if key set)</button></form>
<table class="table table-sm"><thead><tr><th>Pair</th><th>Rate</th><th>Source</th><th>As of</th></tr></thead>
<tbody>
@foreach (var r in Model) {
  <tr><td>@r.BaseCurrency/@r.QuoteCurrency</td><td>@r.Rate</td><td>@r.Source</td><td>@r.AsOfUtc.ToString("u")</td></tr>
}
</tbody></table>
