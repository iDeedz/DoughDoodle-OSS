@model IEnumerable<DoughDoodle.Models.Transaction>
@{ var project = (DoughDoodle.Models.ExpenseProject)ViewBag.Project; ViewData["Title"] = project.Name; }
<h2>@project.Name — transactions</h2>
<a asp-action="Index">Back</a>
<table class="table table-sm mt-2"><thead><tr><th>Date</th><th>Description</th><th>Amount</th></tr></thead>
<tbody>
@foreach (var t in Model) {
  <tr><td>@t.Date.ToString("yyyy-MM-dd")</td><td>@t.Description</td><td>@CurrencyDisplay.Format(t.Amount, ViewData["PreferredCurrency"] as string)</td></tr>
}
</tbody></table>
