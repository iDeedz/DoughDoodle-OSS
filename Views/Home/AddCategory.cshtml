@{
    ViewData["Title"] = "Add Category";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-plus-circle me-2"></i>Add New Envelope Category
                    </h4>
                    <p class="card-text mb-0 opacity-75">Create a new budget envelope for tracking expenses</p>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label for="name" class="form-label fw-semibold">
                                <i class="bi bi-tag me-1"></i>Category Name
                            </label>
                            <input name="name" 
                                   id="name"
                                   class="form-control form-control-lg" 
                                   placeholder="e.g., Groceries, Entertainment, Savings..." 
                                   required 
                                   maxlength="50" />
                            <div class="invalid-feedback">
                                Please provide a category name.
                            </div>
                            <div class="form-text">
                                Choose a descriptive name for your budget envelope. Be specific for better expense tracking.
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-plus-circle me-1"></i>Create Envelope
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6 col-md-12 mt-4 mt-lg-0">
            <div class="card border-info">
                <div class="card-header bg-light">
                    <h5 class="mb-0">💡 Envelope Budgeting Tips</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <h6 class="text-primary">
                                    <i class="bi bi-house-door me-2"></i>Fixed Expenses
                                </h6>
                                <small class="text-muted">Rent, utilities, insurance, loan payments</small>
                            </div>
                            
                            <div class="mb-3">
                                <h6 class="text-warning">
                                    <i class="bi bi-basket me-2"></i>Variable Expenses  
                                </h6>
                                <small class="text-muted">Groceries, entertainment, dining, shopping</small>
                            </div>
                            
                            <div class="mb-3">
                                <h6 class="text-success">
                                    <i class="bi bi-piggy-bank me-2"></i>Savings Goals
                                </h6>
                                <small class="text-muted">Emergency fund, vacation, car, investments</small>
                            </div>
                            
                            <div class="alert alert-info d-flex align-items-center" role="alert">
                                <i class="bi bi-lightbulb me-2"></i>
                                <div class="small">
                                    <strong>Pro Tip:</strong> Start with broad categories, then get more specific as you track your spending patterns.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set focus to input
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('name').focus();
        });
        
        // Bootstrap form validation
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}