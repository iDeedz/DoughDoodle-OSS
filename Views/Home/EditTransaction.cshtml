@model DoughDoodle.Models.Transaction
@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit Transaction
                    </h4>
                    <p class="card-text mb-0 opacity-75">Update your transaction details</p>
                </div>
                <div class="card-body">
                    <form asp-action="EditTransaction" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label for="Description" class="form-label fw-semibold">
                                    <i class="bi bi-card-text me-1"></i>Description
                                </label>
                                <input asp-for="Description" 
                                       class="form-control form-control-lg" 
                                       placeholder="e.g., Grocery shopping, Gas station, Salary..."
                                       required />
                                <span asp-validation-for="Description" class="text-danger small"></span>
                                <div class="form-text">What was this transaction for?</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Amount" class="form-label fw-semibold">
                                    <i class="bi bi-currency-dollar me-1"></i>Amount
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                    <input asp-for="Amount" 
                                           class="form-control form-control-lg" 
                                           type="number" 
                                           step="0.01" 
                                           required />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                                <div class="form-text">Enter positive amount</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="CategoryId" class="form-label fw-semibold">
                                    <i class="bi bi-tag me-1"></i>Category
                                </label>
                                <select asp-for="CategoryId" class="form-select form-select-lg" required>
                                    <option value="">Choose envelope...</option>
                                    @foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                <div class="form-text">Which envelope should this come from?</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-4">
                                <label for="Date" class="form-label fw-semibold">
                                    <i class="bi bi-calendar me-1"></i>Transaction Date
                                </label>
                                <input asp-for="Date" 
                                       type="date" 
                                       class="form-control form-control-lg"
                                       required />
                                <span asp-validation-for="Date" class="text-danger small"></span>
                                <div class="form-text">When did this transaction occur?</div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                            </a>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-danger btn-lg" onclick="confirmDelete(@Model.Id)">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                                <button type="submit" class="btn btn-warning btn-lg text-dark">
                                    <i class="bi bi-check-circle me-1"></i>Update Transaction
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Set focus to first input
        document.getElementById('Description').focus();
        
        // Bootstrap form validation
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
        
        function confirmDelete(transactionId) {
            if (confirm('Are you sure you want to delete this transaction? This action cannot be undone.')) {
                // Create a form to submit delete request
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Home/DeleteTransaction/' + transactionId;
                
                // Add CSRF token if needed
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }
                
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}