@model DoughDoodle.Models.ViewModels.CreateSubAccountViewModel
@{
    ViewData["Title"] = "Create Sub-Account";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="UserManagement">Account Management</a></li>
                <li class="breadcrumb-item active">Create Sub-Account</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header">
                <h3><i class="bi bi-person-plus"></i> Create New Sub-Account</h3>
                <p class="mb-0 text-muted">Add a new user under your main account</p>
            </div>
            <div class="card-body">
                <form asp-action="CreateSubAccount" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-text">This will be the sub-account's login username.</div>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Create temporary password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div class="form-text">The user should change this password after their first login.</div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="UserManagement" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Management
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-person-check"></i> Create Sub-Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="card mt-4">
            <div class="card-body">
                <h5><i class="bi bi-info-circle text-info"></i> Sub-Account Features</h5>
                <div class="row">
                    <div class="col-md-6">
                        <h6>What Sub-Accounts Can Do:</h6>
                        <ul>
                            <li>Create and manage their own budget envelopes</li>
                            <li>Add and track personal transactions</li>
                            <li>Set monthly budget amounts</li>
                            <li>Access AI budget recommendations</li>
                            <li>View their budget history and reports</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6>What You Can Do:</h6>
                        <ul>
                            <li>View all sub-account budgets (read-only)</li>
                            <li>Monitor spending across all accounts</li>
                            <li>Deactivate sub-accounts if needed</li>
                            <li>Get consolidated budget insights</li>
                            <li>Manage account permissions</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}