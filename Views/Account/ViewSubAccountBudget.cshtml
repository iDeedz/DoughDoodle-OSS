@model DoughDoodle.Models.ViewModels.BudgetAccessViewModel
@{
    ViewData["Title"] = $"{Model.User.FullName}'s Budget";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="UserManagement">Account Management</a></li>
            <li class="breadcrumb-item active">@Model.User.FullName's Budget</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-person-circle"></i> @Model.User.FullName's Budget</h2>
                    <p class="text-muted">@Model.CurrentMonth | Read-only view</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-info">Sub-Account</span>
                </div>
            </div>

            @if (Model.Categories.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-wallet2"></i> Envelope Categories</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Envelope Category</th>
                                        <th>Budgeted</th>
                                        <th>Spent</th>
                                        <th>Remaining</th>
                                        <th>Progress</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category in Model.Categories)
                                    {
                                        var currentBudget = category.Budgets.FirstOrDefault(b => b.MonthYear == Model.CurrentMonth)?.Amount ?? 0;
                                        var spent = category.Transactions.Where(t => t.Date.ToString("yyyy-MM") == Model.CurrentMonth).Sum(t => t.Amount);
                                        var remaining = currentBudget - spent;
                                        var percentage = currentBudget > 0 ? (spent / currentBudget) * 100 : 0;
                                        var progressClass = percentage <= 80 ? "bg-success" : percentage <= 100 ? "bg-warning" : "bg-danger";

                                        <tr>
                                            <td>
                                                <strong><i class="bi bi-wallet"></i> @category.Name</strong>
                                            </td>
                                            <td>@CurrencyDisplay.Format(currentBudget, ViewData["PreferredCurrency"] as string)</td>
                                            <td>@CurrencyDisplay.Format(spent, ViewData["PreferredCurrency"] as string)</td>
                                            <td>
                                                <span class="@(remaining >= 0 ? "text-success" : "text-danger")">
                                                    @CurrencyDisplay.Format(remaining, ViewData["PreferredCurrency"] as string)
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-fill me-2" style="height: 20px;">
                                                        <div class="progress-bar @progressClass" 
                                                             style="width: @Math.Min(percentage, 100)%"
                                                             title="@percentage.ToString("F1")% used">
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">@percentage.ToString("F1")%</small>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h5><i class="bi bi-list-ul"></i> Recent Transactions</h5>
                    </div>
                    <div class="card-body">
                        @{
                            var recentTransactions = Model.Categories
                                .SelectMany(c => c.Transactions)
                                .Where(t => t.Date.ToString("yyyy-MM") == Model.CurrentMonth)
                                .OrderByDescending(t => t.Date)
                                .Take(10)
                                .ToList();
                        }

                        @if (recentTransactions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Description</th>
                                            <th>Category</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaction in recentTransactions)
                                        {
                                            <tr>
                                                <td>@transaction.Date.ToString("MMM dd")</td>
                                                <td>@transaction.Description</td>
                                                <td>@transaction.Category!.Name</td>
                                                <td>@CurrencyDisplay.Format(transaction.Amount, ViewData["PreferredCurrency"] as string)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">No transactions this month</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-wallet display-1 text-muted"></i>
                        <h4 class="text-muted">No Budget Categories</h4>
                        <p class="text-muted">This sub-account hasn't created any envelope categories yet.</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-3">
            <!-- Budget Summary -->
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-bar-chart"></i> Budget Summary</h5>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <div class="mb-3">
                            <small class="text-muted d-block">BUDGETED</small>
                            <h4 class="text-primary">@CurrencyDisplay.Format(Model.TotalBudgeted, ViewData["PreferredCurrency"] as string)</h4>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">SPENT</small>
                            <h4 class="text-info">@CurrencyDisplay.Format(Model.TotalSpent, ViewData["PreferredCurrency"] as string)</h4>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">REMAINING</small>
                            <h4 class="@(Model.TotalRemaining >= 0 ? "text-success" : "text-danger")">
                                @CurrencyDisplay.Format(Model.TotalRemaining, ViewData["PreferredCurrency"] as string)
                            </h4>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="text-center">
                        @{
                            var overallPercentage = Model.TotalBudgeted > 0 ? (Model.TotalSpent / Model.TotalBudgeted) * 100 : 0;
                            var overallProgressClass = overallPercentage <= 80 ? "bg-success" : overallPercentage <= 100 ? "bg-warning" : "bg-danger";
                        }
                        
                        <small class="text-muted d-block">OVERALL PROGRESS</small>
                        <div class="progress mb-2" style="height: 25px;">
                            <div class="progress-bar @overallProgressClass" 
                                 style="width: @Math.Min(overallPercentage, 100)%"
                                 title="@overallPercentage.ToString("F1")% of budget used">
                                @overallPercentage.ToString("F1")%
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Info -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6><i class="bi bi-info-circle"></i> Account Details</h6>
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.User.FullName</p>
                    <p><strong>Email:</strong> @Model.User.Email</p>
                    <p><strong>Member Since:</strong> @Model.User.CreatedAt.ToString("MMM yyyy")</p>
                    <p><strong>Categories:</strong> @Model.Categories.Count</p>
                </div>
            </div>

            <!-- Actions -->
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-grid">
                        <a asp-action="UserManagement" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Management
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>