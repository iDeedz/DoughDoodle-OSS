@using DoughDoodle.Models
@inject DoughDoodle.Services.Billing.IDoughEntitlementService DoughEntitlements
@using DoughDoodle.Models.ViewModels
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Chart.js CDN with Enhanced Fallback -->
<script>
    // Enhanced fallback for Chart.js when CDN is blocked
    window.ChartFallback = function(ctx, config) {
        console.log('Chart.js fallback: Creating chart', config);
        var canvas = ctx.canvas;
        var parent = canvas.parentElement;
        
        // Hide canvas
        canvas.style.display = 'none';
        
        // Create fallback content
        var fallback = document.createElement('div');
        fallback.className = 'chart-fallback text-center p-4';
        fallback.style.cssText = `
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border: 2px dashed #6c757d;
            border-radius: 12px;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            margin: 10px 0;
        `;
        
        var icon = document.createElement('i');
        icon.className = 'bi bi-graph-up-arrow fs-2 text-primary mb-3';
        
        var title = document.createElement('h6');
        title.textContent = config.type.charAt(0).toUpperCase() + config.type.slice(1) + ' Chart';
        title.className = 'text-dark mb-2 fw-bold';
        
        var dataInfo = document.createElement('div');
        var dataPoints = config.data.datasets?.[0]?.data?.length || 0;
        var labels = config.data.labels?.length || 0;
        dataInfo.innerHTML = `
            <small class="text-muted d-block">📊 ${dataPoints} data points</small>
            <small class="text-muted d-block">📅 ${labels} time periods</small>
        `;
        
        fallback.appendChild(icon);
        fallback.appendChild(title);
        fallback.appendChild(dataInfo);
        
        parent.appendChild(fallback);
        return { fallback: true };
    };
    
    // Override Chart constructor if not loaded
    if (typeof Chart === 'undefined') {
        window.Chart = window.ChartFallback;
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js" onerror="console.log('Chart.js CDN failed, using fallback'); window.Chart = window.ChartFallback;"></script>

<div class="container-fluid">
    <div class="row">
        <!-- Header -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-speedometer2 text-primary"></i> Admin Analytics Dashboard</h1>
                    <p class="text-muted mb-0">Comprehensive system analytics and user insights</p>
                </div>
                <div>
                    <a asp-action="Users" class="btn btn-primary me-2">
                        <i class="bi bi-people"></i> Manage Users
                    </a>
                    <a asp-action="Settings" class="btn btn-outline-secondary">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="avatar-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-people-fill fs-2"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="mb-0 text-muted">Total Users</h6>
                            <h2 class="mb-0">@Model.TotalUsers.ToString("N0")</h2>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> @(Model.TotalUsers - Model.ExpiredTrialUsers) active
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="avatar-lg bg-success text-white rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-currency-dollar fs-2"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="mb-0 text-muted">Monthly Revenue</h6>
                            <h2 class="mb-0">@CurrencyDisplay.Format(Model.SystemStats.MonthlyRecurringRevenue, ViewData["PreferredCurrency"] as string, compact: true)</h2>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> MRR
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="avatar-lg bg-warning text-white rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-graph-up fs-2"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="mb-0 text-muted">System Health</h6>
                            <h2 class="mb-0">@Model.Analytics.SystemHealthScore%</h2>
                            <small class="@(Model.Analytics.SystemHealthScore >= 80 ? "text-success" : Model.Analytics.SystemHealthScore >= 60 ? "text-warning" : "text-danger")">
                                <i class="bi bi-heart-pulse"></i> 
                                @(Model.Analytics.SystemHealthScore >= 80 ? "Excellent" : Model.Analytics.SystemHealthScore >= 60 ? "Good" : "Needs Attention")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="avatar-lg bg-info text-white rounded-circle d-flex align-items-center justify-content-center">
                                <i class="bi bi-activity fs-2"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="mb-0 text-muted">Active This Month</h6>
                            <h2 class="mb-0">@Model.Analytics.ActiveUsersThisMonth</h2>
                            <small class="text-info">
                                <i class="bi bi-calendar-check"></i> @Math.Round((double)Model.Analytics.ActiveUsersThisMonth / Model.TotalUsers * 100, 1)% engagement
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- User Growth Chart -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-graph-up-arrow text-primary"></i> User Growth</h5>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                6 Months
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" onclick="updateChart('userGrowth', '3months')">3 Months</a></li>
                                <li><a class="dropdown-item" href="#" onclick="updateChart('userGrowth', '6months')">6 Months</a></li>
                                <li><a class="dropdown-item" href="#" onclick="updateChart('userGrowth', '12months')">12 Months</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="userGrowthChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Subscription Distribution -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom-0">
                    <h5 class="mb-0"><i class="bi bi-pie-chart text-primary"></i> Subscription Distribution</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="subscriptionChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue and Activity Charts -->
    <div class="row g-4 mb-4">
        <!-- Revenue Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom-0">
                    <h5 class="mb-0"><i class="bi bi-cash-coin text-success"></i> Monthly Revenue Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- User Activity Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom-0">
                    <h5 class="mb-0"><i class="bi bi-activity text-info"></i> User Activity (Last 30 Days)</h5>
                </div>
                <div class="card-body">
                    <canvas id="activityChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- System Stats and Recent Users -->
    <div class="row g-4 mb-4">
        <!-- Enhanced System Statistics -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom-0">
                    <h5 class="mb-0"><i class="bi bi-bar-chart text-primary"></i> System Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="border-end">
                                <h4 class="text-primary mb-1">@Model.SystemStats.TotalCategories.ToString("N0")</h4>
                                <small class="text-muted">Total Categories</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <h4 class="text-success mb-1">@Model.SystemStats.TotalTransactions.ToString("N0")</h4>
                            <small class="text-muted">Total Transactions</small>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="border-end">
                                <h4 class="text-warning mb-1">@Model.SystemStats.TotalBudgets.ToString("N0")</h4>
                                <small class="text-muted">Monthly Budgets</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <h4 class="text-info mb-1">@Model.SystemStats.TotalSubAccounts</h4>
                            <small class="text-muted">Sub-Accounts</small>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="row text-center">
                        <div class="col-12 mb-2">
                            <h6 class="text-muted">Average per User</h6>
                        </div>
                        <div class="col-6">
                            <span class="badge bg-primary p-2">@Model.Analytics.AvgTransactionsPerUser tx</span>
                        </div>
                        <div class="col-6">
                            <span class="badge bg-success p-2">@Model.Analytics.AvgCategoriesPerUser cat</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent User Registrations -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-plus text-success"></i> Recent User Registrations</h5>
                        <a asp-action="Users" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Type</th>
                                    <th>Plan</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light rounded-circle d-flex align-items-center justify-content-center me-2">
                                                    <i class="bi bi-person text-muted"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-medium">@user.FullName</div>
                                                    <small class="text-muted">@user.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(user.UserType == DoughDoodle.Models.UserType.MainAccount ? "bg-primary" : "bg-info")">
                                                @user.UserType
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(user.SubscriptionPlan == DoughDoodle.Models.SubscriptionPlan.Pocket ? "bg-warning" : "bg-success")">
                                                @DoughEntitlements.GetPackDisplayName((DoughTier)(int)user.SubscriptionPlan)
                                            </span>
                                        </td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td>
                                            <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Trial Conversion Rate -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom-0">
                    <h5 class="mb-0"><i class="bi bi-funnel text-warning"></i> Trial Conversion Analytics</h5>
                </div>
                <div class="card-body">
                    <canvas id="conversionChart" height="60"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-lg {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
    }
    
    .avatar-sm {
        width: 35px;
        height: 35px;
        font-size: 0.9rem;
    }
    
    .card {
        transition: all 0.3s ease;
        border-radius: 12px;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        color: #495057;
    }
</style>

<script>
    // User Growth Chart
    const userGrowthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.UserGrowthChart));
    const userGrowthCtx = document.getElementById('userGrowthChart').getContext('2d');
    new Chart(userGrowthCtx, {
        type: 'line',
        data: {
            labels: userGrowthData.map(d => d.date),
            datasets: [{
                label: 'New Users',
                data: userGrowthData.map(d => d.newUsers),
                borderColor: '#007bff',
                backgroundColor: 'rgba(0, 123, 255, 0.1)',
                fill: true,
                tension: 0.4
            }, {
                label: 'Cumulative Users',
                data: userGrowthData.map(d => d.cumulativeUsers),
                borderColor: '#28a745',
                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            },
            plugins: {
                legend: {
                    position: 'top'
                }
            }
        }
    });

    // Subscription Distribution Chart
    const subscriptionData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.SubscriptionDistribution));
    const subscriptionCtx = document.getElementById('subscriptionChart').getContext('2d');
    new Chart(subscriptionCtx, {
        type: 'doughnut',
        data: {
            labels: subscriptionData.map(d => d.plan),
            datasets: [{
                data: subscriptionData.map(d => d.count),
                backgroundColor: ['#28a745', '#007bff', '#ffc107', '#dc3545', '#6f42c1'],
                borderWidth: 3,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });

    // Revenue Chart
    const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.RevenueChart));
    const currencyPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)));
    const revenueCtx = document.getElementById('revenueChart').getContext('2d');
    new Chart(revenueCtx, {
        type: 'bar',
        data: {
            labels: revenueData.map(d => d.month),
            datasets: [{
                label: 'Revenue (' + currencyPrefix + ')',
                data: revenueData.map(d => d.revenue),
                backgroundColor: 'rgba(40, 167, 69, 0.8)',
                borderColor: '#28a745',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return currencyPrefix + value.toLocaleString();
                        }
                    }
                }
            }
        }
    });

    // Activity Chart
    const activityData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.UserActivityChart));
    const activityCtx = document.getElementById('activityChart').getContext('2d');
    new Chart(activityCtx, {
        type: 'line',
        data: {
            labels: activityData.map(d => d.date),
            datasets: [{
                label: 'Active Users',
                data: activityData.map(d => d.activeUsers),
                borderColor: '#17a2b8',
                backgroundColor: 'rgba(23, 162, 184, 0.1)',
                fill: true,
                tension: 0.4
            }, {
                label: 'Transactions',
                data: activityData.map(d => d.transactions),
                borderColor: '#ffc107',
                backgroundColor: 'rgba(255, 193, 7, 0.1)',
                fill: false,
                tension: 0.4,
                yAxisID: 'y1'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    grid: {
                        drawOnChartArea: false,
                    },
                }
            }
        }
    });

    // Conversion Chart
    const conversionData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.TrialConversions));
    const conversionCtx = document.getElementById('conversionChart').getContext('2d');
    new Chart(conversionCtx, {
        type: 'bar',
        data: {
            labels: conversionData.map(d => d.cohortMonth),
            datasets: [{
                label: 'Trial Users',
                data: conversionData.map(d => d.trialUsers),
                backgroundColor: 'rgba(255, 193, 7, 0.8)',
                borderColor: '#ffc107',
                borderWidth: 1
            }, {
                label: 'Conversions',
                data: conversionData.map(d => d.conversions),
                backgroundColor: 'rgba(40, 167, 69, 0.8)',
                borderColor: '#28a745',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

</div>

<style>
    .avatar-lg {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
    }
    
    .avatar-sm {
        width: 35px;
        height: 35px;
        font-size: 0.9rem;
    }
    
    .card {
        transition: all 0.3s ease;
        border-radius: 12px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }
    
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        color: #495057;
    }
    
    .chart-fallback {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
</style>
</style>