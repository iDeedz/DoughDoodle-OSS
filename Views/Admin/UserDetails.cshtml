@using DoughDoodle.Models
@inject DoughDoodle.Services.Billing.IDoughEntitlementService DoughEntitlements
@using DoughDoodle.Models.ViewModels
@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-person-circle"></i> User Details</h1>
                    <p class="text-muted mb-0">Complete information for @Model.User.FullName</p>
                </div>
                <div>
                    <a asp-action="Users" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Back to Users
                    </a>
                </div>
            </div>

            <div class="row">
                <!-- User Information -->
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5><i class="bi bi-person-badge"></i> Basic Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-4">Full Name:</dt>
                                        <dd class="col-sm-8">@Model.User.FullName</dd>
                                        
                                        <dt class="col-sm-4">Email:</dt>
                                        <dd class="col-sm-8">@Model.User.Email</dd>
                                        
                                        <dt class="col-sm-4">User Type:</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.User.UserType == DoughDoodle.Models.UserType.MainAccount)
                                            {
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-person-gear"></i> Main Account
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">
                                                    <i class="bi bi-person-plus"></i> Sub-Account
                                                </span>
                                            }
                                        </dd>
                                        
                                        <dt class="col-sm-4">Status:</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.User.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-x-circle"></i> Inactive
                                                </span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-4">Created:</dt>
                                        <dd class="col-sm-8">@Model.User.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                                        
                                        <dt class="col-sm-4">User ID:</dt>
                                        <dd class="col-sm-8"><small class="text-muted">@Model.User.Id</small></dd>
                                        
                                        <dt class="col-sm-4">Phone:</dt>
                                        <dd class="col-sm-8">@(Model.User.PhoneNumber ?? "Not provided")</dd>
                                        
                                        <dt class="col-sm-4">Last Activity:</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.LastActivity.HasValue)
                                            {
                                                @Model.LastActivity.Value.ToString("MMM dd, yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">No activity</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Subscription Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5><i class="bi bi-credit-card"></i> Subscription & Payment</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-5">Plan:</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.User.SubscriptionPlan == DoughDoodle.Models.SubscriptionPlan.Pocket)
                                            {
                                                <span class="badge bg-warning text-dark">Free</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@DoughEntitlements.GetPackDisplayName((DoughTier)(int)Model.User.SubscriptionPlan)</span>
                                            }
                                        </dd>
                                        
                                        <dt class="col-sm-5">Trial Status:</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.User.SubscriptionPlan == DoughDoodle.Models.SubscriptionPlan.Pocket)
                                            {
                                                @if (Model.User.IsTrialExpired)
                                                {
                                                    <span class="badge bg-danger">Expired</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">@Model.User.DaysRemainingInTrial days left</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-6">Trial End Date:</dt>
                                        <dd class="col-sm-6">@Model.User.TrialEndDate.ToString("MMM dd, yyyy")</dd>
                                        
                                        <dt class="col-sm-6">Last Payment:</dt>
                                        <dd class="col-sm-6">
                                            @if (Model.User.LastPaymentDate.HasValue)
                                            {
                                                @Model.User.LastPaymentDate.Value.ToString("MMM dd, yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">None</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Account Statistics -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5><i class="bi bi-bar-chart"></i> Usage Statistics</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <div class="stat-box">
                                        <h3 class="text-primary">@Model.TotalCategories</h3>
                                        <p class="text-muted">Categories</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-box">
                                        <h3 class="text-info">@Model.TotalTransactions</h3>
                                        <p class="text-muted">Transactions</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-box">
                                        <h3 class="text-success">@CurrencyDisplay.Format(Model.TotalBudgetAmount, ViewData["PreferredCurrency"] as string)</h3>
                                        <p class="text-muted">Budget Amount</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-box">
                                        <h3 class="text-warning">@Model.User.SubAccounts.Count(s => s.IsActive)</h3>
                                        <p class="text-muted">Sub-Accounts</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Relationship Information -->
                    @if (Model.User.UserType == DoughDoodle.Models.UserType.SubAccount)
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5><i class="bi bi-diagram-3"></i> Parent Account</h5>
                            </div>
                            <div class="card-body">
                                @if (Model.User.ParentUser != null)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <strong>@Model.User.ParentUser.FullName</strong>
                                            <br><small class="text-muted">@Model.User.ParentUser.Email</small>
                                        </div>
                                        <div class="ms-auto">
                                            <a asp-action="UserDetails" asp-route-id="@Model.User.ParentUser.Id" class="btn btn-sm btn-outline-primary">
                                                View Parent <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">Parent account information not available.</p>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.User.UserType == DoughDoodle.Models.UserType.MainAccount && Model.User.SubAccounts.Any())
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5><i class="bi bi-people"></i> Sub-Accounts (@Model.User.SubAccounts.Count)</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @foreach (var subAccount in Model.User.SubAccounts)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="card border-light">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-circle me-3" style="width: 30px; height: 30px; font-size: 0.9rem;">
                                                                <i class="bi bi-person-fill"></i>
                                                            </div>
                                                            <div>
                                                                <strong>@subAccount.FullName</strong>
                                                                <br><small class="text-muted">@subAccount.Email</small>
                                                                <br>
                                                                @if (subAccount.IsActive)
                                                                {
                                                                    <span class="badge bg-success">Active</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary">Inactive</span>
                                                                }
                                                            </div>
                                                        </div>
                                                        <a asp-action="UserDetails" asp-route-id="@subAccount.Id" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Actions Panel -->
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="bi bi-gear"></i> Admin Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                @if (Model.User.IsActive)
                                {
                                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                                        <i class="bi bi-pause-circle"></i> Deactivate User
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="ReactivateUser" method="post">
                                        <input type="hidden" name="userId" value="@Model.User.Id" />
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="bi bi-play-circle"></i> Reactivate User
                                        </button>
                                    </form>
                                }

                                @if (Model.User.SubscriptionPlan == DoughDoodle.Models.SubscriptionPlan.Pocket)
                                {
                                    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#extendTrialModal">
                                        <i class="bi bi-calendar-plus"></i> Extend Trial
                                    </button>
                                }

                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#updateSubscriptionModal">
                                    <i class="bi bi-credit-card"></i> Update Subscription
                                </button>
                            </div>

                            <hr>

                            <h6>Quick Stats</h6>
                            <ul class="list-unstyled">
                                <li><strong>Account Status:</strong> @Model.User.AccountStatus</li>
                                <li><strong>Sub-Account Limit:</strong> @Model.User.SubAccountLimit</li>
                                <li><strong>Can Create Sub-Accounts:</strong> @(Model.User.CanCreateSubAccount ? "Yes" : "No")</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals would go here similar to the Users.cshtml file -->
<!-- ... (deactivate, extend trial, update subscription modals) -->

<style>
    .stat-box {
        padding: 1rem;
        border-radius: 0.375rem;
        background-color: #f8f9fa;
        margin-bottom: 1rem;
    }
    
    .stat-box h3 {
        margin-bottom: 0.5rem;
        font-weight: 700;
    }
    
    .stat-box p {
        margin-bottom: 0;
        font-size: 0.875rem;
    }
</style>