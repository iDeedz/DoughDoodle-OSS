@using DoughDoodle.Models.ViewModels
@model BrowseTableViewModel
@{
    ViewData["Title"] = $"Browse Table: {Model.TableName}";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>
                        <i class="bi bi-table text-primary"></i> @Model.TableName
                        <span class="badge bg-secondary ms-2">@Model.TotalRecords.ToString("N0") records</span>
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a asp-action="Dashboard">Admin</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a asp-action="DatabaseManager">Database Manager</a>
                            </li>
                            <li class="breadcrumb-item active">@Model.TableName</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a asp-action="ExportTable" asp-route-tableName="@Model.TableName" asp-route-format="csv" 
                       class="btn btn-success me-2">
                        <i class="bi bi-download"></i> Export CSV
                    </a>
                    <a asp-action="DatabaseManager" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Back to Tables
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Data -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-database"></i> Table Data
                            <small class="text-muted ms-2">
                                Page @Model.Page of @Model.TotalPages
                            </small>
                        </h5>
                        <div class="d-flex align-items-center">
                            <label class="me-2 small">Records per page:</label>
                            <select class="form-select form-select-sm" style="width: auto;" onchange="changePageSize(this.value)">
                                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                                <option value="100" selected="@(Model.PageSize == 100)">100</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.Data.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        @foreach (var column in Model.Data.First().Keys)
                                        {
                                            <th scope="col">@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.Data)
                                    {
                                        <tr>
                                            @foreach (var value in row.Values)
                                            {
                                                <td>
                                                    @if (value is bool boolValue)
                                                    {
                                                        <span class="badge bg-@(boolValue ? "success" : "secondary")">
                                                            <i class="bi bi-@(boolValue ? "check" : "x")"></i>
                                                            @boolValue
                                                        </span>
                                                    }
                                                    else if (value is decimal || value is double || value is float)
                                                    {
                                                        <span class="text-end d-block font-monospace">@value</span>
                                                    }
                                                    else if (value != null && value.ToString().Contains("@"))
                                                    {
                                                        <span class="text-primary">
                                                            <i class="bi bi-envelope me-1"></i>@value
                                                        </span>
                                                    }
                                                    else if (value != null && DateTime.TryParse(value.ToString(), out _))
                                                    {
                                                        <span class="text-muted font-monospace">@value</span>
                                                    }
                                                    else
                                                    {
                                                        @if (value != null && value.ToString().Length > 50)
                                                        {
                                                            <span title="@value">@value.ToString().Substring(0, 47)...</span>
                                                        }
                                                        else
                                                        {
                                                            @value
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No data available</h5>
                            <p class="text-muted">This table appears to be empty or no records match the current criteria.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="row mt-4">
            <div class="col-12">
                <nav aria-label="Table pagination">
                    <ul class="pagination justify-content-center">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-route-tableName="@Model.TableName" asp-route-page="1" asp-route-pageSize="@Model.PageSize">
                                    First
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" asp-route-tableName="@Model.TableName" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">
                                    Previous
                                </a>
                            </li>
                        }

                        @{
                            var startPage = Math.Max(1, Model.Page - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" asp-route-tableName="@Model.TableName" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-route-tableName="@Model.TableName" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">
                                    Next
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" asp-route-tableName="@Model.TableName" asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.PageSize">
                                    Last
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    }

    <!-- Table Statistics -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    <h6><i class="bi bi-graph-up"></i> Table Statistics</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number text-primary">@Model.TotalRecords.ToString("N0")</div>
                                <div class="stat-label">Total Records</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number text-success">@Model.TotalPages</div>
                                <div class="stat-label">Total Pages</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number text-info">@Model.PageSize</div>
                                <div class="stat-label">Page Size</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number text-warning">@(Model.Data?.FirstOrDefault()?.Keys.Count ?? 0)</div>
                                <div class="stat-label">Columns</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changePageSize(newPageSize) {
        var url = new URL(window.location);
        url.searchParams.set('pageSize', newPageSize);
        url.searchParams.set('page', '1'); // Reset to first page
        window.location.href = url.toString();
    }
</script>

<style>
    .table {
        font-size: 0.875rem;
    }
    
    .table th {
        white-space: nowrap;
        font-weight: 600;
        background-color: #343a40;
        color: white;
        border-color: #454d55;
    }
    
    .table td {
        vertical-align: middle;
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .stat-item {
        padding: 1rem;
    }
    
    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
    }
    
    .stat-label {
        font-size: 0.875rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .font-monospace {
        font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
    }
</style>