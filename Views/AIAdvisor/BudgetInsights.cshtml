@model List<DoughDoodle.Models.Category>
@{
    ViewData["Title"] = "Budget Insights";
    var currentMonth = ViewBag.CurrentMonth as string ?? DateTime.Now.ToString("yyyy-MM");
    var monthLabel = DateTime.ParseExact(currentMonth + "-01", "yyyy-MM-dd", null).ToString("MMMM yyyy");

    var categoriesWithBudget = Model.Where(c => c.Budgets.Any(b => b.MonthYear == currentMonth)).ToList();
    var totalBudgeted = categoriesWithBudget.Sum(c => c.Budgets.First(b => b.MonthYear == currentMonth).Amount);
    var totalSpent = Model.Sum(c => c.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => Math.Abs(t.Amount)));
    var overspent = Model.Where(c =>
    {
        var budget = c.Budgets.FirstOrDefault(b => b.MonthYear == currentMonth)?.Amount ?? 0;
        var spent = c.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => t.Amount);
        return (budget + spent) < 0;
    }).ToList();
    var underutilized = Model.Where(c =>
    {
        var budget = c.Budgets.FirstOrDefault(b => b.MonthYear == currentMonth)?.Amount ?? 0;
        if (budget <= 0) return false;
        var spent = c.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => t.Amount);
        var usedPct = budget > 0 ? (Math.Abs(spent) / budget) * 100 : 0;
        return usedPct < 50;
    }).OrderBy(c =>
    {
        var budget = c.Budgets.First(b => b.MonthYear == currentMonth).Amount;
        var spent = c.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => t.Amount);
        return budget > 0 ? Math.Abs(spent) / budget : 0;
    }).Take(5).ToList();
    var topSpending = Model
        .Select(c => new {
            Category = c,
            Spent = Math.Abs(c.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => t.Amount))
        })
        .Where(x => x.Spent > 0)
        .OrderByDescending(x => x.Spent)
        .Take(5)
        .ToList();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-lightbulb text-warning"></i> Budget Insights</h1>
                    <p class="text-muted mb-0">Overview for @monthLabel</p>
                </div>
                <div class="btn-group">
                    <a asp-controller="Home" asp-action="Index" asp-route-month="@currentMonth" class="btn btn-outline-secondary">
                        <i class="bi bi-house"></i> Dashboard
                    </a>
                    <a asp-controller="Budget" asp-action="MonthlyWorkflow" asp-route-monthYear="@currentMonth" class="btn btn-outline-primary">
                        <i class="bi bi-calendar3"></i> Monthly Workflow
                    </a>
                    <a asp-controller="AIAdvisor" asp-action="SmartInsights" class="btn btn-outline-info">
                        <i class="bi bi-stars"></i> AI Smart Insights
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Total Budgeted</h6>
                            <h3 class="text-primary mb-0">@CurrencyDisplay.Format(totalBudgeted, ViewData["PreferredCurrency"] as string)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Total Spent</h6>
                            <h3 class="text-warning mb-0">@CurrencyDisplay.Format(totalSpent, ViewData["PreferredCurrency"] as string)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card @(overspent.Any() ? "border-danger" : "border-success")">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Overspent Categories</h6>
                            <h3 class="@(overspent.Any() ? "text-danger" : "text-success") mb-0">@overspent.Count</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-exclamation-triangle text-danger"></i> Overspent Categories</h5>
                        </div>
                        <div class="card-body">
                            @if (!overspent.Any())
                            {
                                <p class="text-muted mb-0"><i class="bi bi-check-circle text-success"></i> All categories are within budget this month.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var category in overspent)
                                    {
                                        var budget = category.Budgets.FirstOrDefault(b => b.MonthYear == currentMonth)?.Amount ?? 0;
                                        var spent = category.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => t.Amount);
                                        var over = Math.Abs(budget + spent);
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @category.Name
                                            <span class="badge bg-danger">@CurrencyDisplay.Format(over, ViewData["PreferredCurrency"] as string) over</span>
                                        </li>
                                    }
                                </ul>
                                <div class="mt-3">
                                    <a asp-controller="Budget" asp-action="CoverOverspend" asp-route-monthYear="@currentMonth" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-shield-exclamation"></i> Cover Overspending
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-bar-chart text-primary"></i> Top Spending</h5>
                        </div>
                        <div class="card-body">
                            @if (!topSpending.Any())
                            {
                                <p class="text-muted mb-0">No spending recorded this month yet.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var item in topSpending)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @item.Category.Name
                                            <span class="badge bg-primary">@CurrencyDisplay.Format(item.Spent, ViewData["PreferredCurrency"] as string)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (underutilized.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-piggy-bank text-success"></i> Underutilized Budgets</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">These categories have used less than 50% of their budget — consider reallocating funds.</p>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Budgeted</th>
                                        <th class="text-end">Spent</th>
                                        <th class="text-end">Remaining</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category in underutilized)
                                    {
                                        var budget = category.Budgets.First(b => b.MonthYear == currentMonth).Amount;
                                        var spent = Math.Abs(category.Transactions.Where(t => t.Date.ToString("yyyy-MM") == currentMonth).Sum(t => t.Amount));
                                        <tr>
                                            <td>@category.Name</td>
                                            <td class="text-end">@CurrencyDisplay.Format(budget, ViewData["PreferredCurrency"] as string)</td>
                                            <td class="text-end">@CurrencyDisplay.Format(spent, ViewData["PreferredCurrency"] as string)</td>
                                            <td class="text-end text-success">@CurrencyDisplay.Format(budget - spent, ViewData["PreferredCurrency"] as string)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="Budget" asp-action="Transfer" asp-route-monthYear="@currentMonth" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-arrow-left-right"></i> Transfer Surplus Funds
                        </a>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-robot"></i> AI-Powered Analysis</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Get deeper recommendations powered by AI for your budget categories.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="AIAdvisor" asp-action="BudgetForecasting" class="btn btn-outline-primary">
                            <i class="bi bi-graph-up"></i> Budget Forecasting
                        </a>
                        <a asp-controller="AIAdvisor" asp-action="SavingsPlanner" class="btn btn-outline-success">
                            <i class="bi bi-piggy-bank"></i> Savings Planner
                        </a>
                        <a asp-controller="AIAdvisor" asp-action="DebtManager" class="btn btn-outline-danger">
                            <i class="bi bi-credit-card"></i> Debt Manager
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
