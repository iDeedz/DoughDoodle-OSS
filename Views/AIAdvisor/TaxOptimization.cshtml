@{
    ViewData["Title"] = "Tax Optimization";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-calculator text-success"></i> AI Tax Optimization</h1>
            <p class="text-muted">Get personalized tax-saving strategies based on your spending and income</p>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Input Section -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-gear"></i> Your Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label for="annualIncome" class="form-label">Annual Income</label>
                    <div class="input-group mb-3">
                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                        <input type="number" class="form-control" id="annualIncome" placeholder="75000" min="0" step="1000">
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button id="getTaxAdvice" class="btn btn-success w-100 mb-3">
                        <i class="bi bi-robot"></i> Get AI Tax Optimization
                    </button>
                </div>
            </div>
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle"></i> The AI will analyze your spending patterns from the past year to identify tax-saving opportunities.
            </div>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Analyzing your financial data for tax optimization opportunities...</p>
    </div>

    <!-- Results Section -->
    <div id="resultsSection" style="display: none;">
        <!-- Tax Bracket -->
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Your Tax Situation</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted">Estimated Tax Bracket</h6>
                        <h3 id="taxBracket" class="text-primary">--</h3>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Estimated Total Savings</h6>
                        <h3 id="totalSavings" class="text-success">--</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tax Deduction Suggestions -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-receipt"></i> Tax Deduction Opportunities</h5>
            </div>
            <div class="card-body">
                <div id="deductionsList"></div>
            </div>
        </div>

        <!-- Tax Credits -->
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-award"></i> Tax Credit Opportunities</h5>
            </div>
            <div class="card-body">
                <div id="creditsList"></div>
            </div>
        </div>

        <!-- Retirement Contributions -->
        <div class="card mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-piggy-bank"></i> Retirement Contribution Strategies</h5>
            </div>
            <div class="card-body">
                <div id="retirementList"></div>
            </div>
        </div>

        <!-- General Tips -->
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="bi bi-lightbulb"></i> General Tax Tips</h5>
            </div>
            <div class="card-body">
                <ul id="tipsList"></ul>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> <strong>Disclaimer:</strong> These are AI-generated suggestions for informational purposes only. Please consult with a qualified tax professional for personalized tax advice.
        </div>
    </div>
</div>

@section Scripts {
<script>
    const currencySymbol = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)));
    document.getElementById('getTaxAdvice').addEventListener('click', async function() {
        const annualIncome = document.getElementById('annualIncome').value;
        
        if (!annualIncome || annualIncome <= 0) {
            alert('Please enter your annual income');
            return;
        }

        // Show loading spinner
        document.getElementById('loadingSpinner').style.display = 'block';
        document.getElementById('resultsSection').style.display = 'none';

        try {
            const response = await fetch(`@Url.Action("GetTaxOptimization", "AIAdvisor")?annualIncome=${annualIncome}`);
            const data = await response.json();

            // Update tax bracket and total savings
            document.getElementById('taxBracket').textContent = data.taxBracket || '--';
            document.getElementById('totalSavings').textContent = currencySymbol + (data.estimatedTotalSavings || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            // Display deductions
            let deductionsHtml = '';
            if (data.deductionSuggestions && data.deductionSuggestions.length > 0) {
                data.deductionSuggestions.forEach(deduction => {
                    deductionsHtml += `
                        <div class="mb-3 p-3 border rounded">
                            <h6 class="text-success">${deduction.title}</h6>
                            <p class="mb-2">${deduction.description}</p>
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">Potential Savings:</small>
                                    <strong class="text-success d-block">${currencySymbol}${deduction.potentialSavings.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">Action Required:</small>
                                    <span class="d-block">${deduction.actionRequired}</span>
                                </div>
                            </div>
                        </div>
                    `;
                });
            } else {
                deductionsHtml = '<p class="text-muted">No specific deduction opportunities identified.</p>';
            }
            document.getElementById('deductionsList').innerHTML = deductionsHtml;

            // Display credits
            let creditsHtml = '';
            if (data.creditSuggestions && data.creditSuggestions.length > 0) {
                data.creditSuggestions.forEach(credit => {
                    creditsHtml += `
                        <div class="mb-3 p-3 border rounded">
                            <h6 class="text-info">${credit.title}</h6>
                            <p class="mb-2">${credit.description}</p>
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted">Potential Credit:</small>
                                    <strong class="text-info d-block">${currencySymbol}${credit.potentialCredit.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Eligibility:</small>
                                    <span class="d-block">${credit.eligibility}</span>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Action Required:</small>
                                    <span class="d-block">${credit.actionRequired}</span>
                                </div>
                            </div>
                        </div>
                    `;
                });
            } else {
                creditsHtml = '<p class="text-muted">No specific credit opportunities identified.</p>';
            }
            document.getElementById('creditsList').innerHTML = creditsHtml;

            // Display retirement suggestions
            let retirementHtml = '';
            if (data.retirementSuggestions && data.retirementSuggestions.length > 0) {
                data.retirementSuggestions.forEach(suggestion => {
                    retirementHtml += `
                        <div class="mb-3 p-3 border rounded">
                            <h6 class="text-warning">${suggestion.accountType}</h6>
                            <p class="mb-2">${suggestion.reasoning}</p>
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">Suggested Contribution:</small>
                                    <strong class="text-primary d-block">${currencySymbol}${suggestion.suggestedContribution.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">Tax Savings:</small>
                                    <strong class="text-success d-block">${currencySymbol}${suggestion.taxSavings.toLocaleString('en-US', { minimumFractionDigits: 2 })}</strong>
                                </div>
                            </div>
                        </div>
                    `;
                });
            } else {
                retirementHtml = '<p class="text-muted">No specific retirement strategies identified.</p>';
            }
            document.getElementById('retirementList').innerHTML = retirementHtml;

            // Display general tips
            let tipsHtml = '';
            if (data.generalTips && data.generalTips.length > 0) {
                data.generalTips.forEach(tip => {
                    tipsHtml += `<li class="mb-2">${tip}</li>`;
                });
            } else {
                tipsHtml = '<li>No general tips available at this time.</li>';
            }
            document.getElementById('tipsList').innerHTML = tipsHtml;

            // Show results
            document.getElementById('loadingSpinner').style.display = 'none';
            document.getElementById('resultsSection').style.display = 'block';
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred while getting tax optimization suggestions. Please try again.');
            document.getElementById('loadingSpinner').style.display = 'none';
        }
    });
</script>
}
