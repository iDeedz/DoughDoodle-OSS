@model DoughDoodle.Models.NetWorthItem
@{
    ViewData["Title"] = "Edit Item";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-pencil-square"></i> Edit @(Model.IsAsset ? "Asset" : "Liability")</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">Name *</label>
                                    <input asp-for="Name" class="form-control" placeholder="e.g., Savings Account, Home Mortgage" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="CurrentValue" class="form-label">Current Value *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">@CurrencyDisplay.Symbol(ViewData["PreferredCurrency"] as string)</span>
                                        <input asp-for="CurrentValue" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="CurrentValue" class="text-danger"></span>
                                    <div class="form-text">Changing the value adds a history record.</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Item Type *</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input asp-for="IsAsset" class="form-check-input" type="radio" value="true" id="typeAsset" />
                                    <label class="form-check-label text-success" for="typeAsset">
                                        <i class="bi bi-plus-circle"></i> Asset
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="IsAsset" class="form-check-input" type="radio" value="false" id="typeLiability" />
                                    <label class="form-check-label text-danger" for="typeLiability">
                                        <i class="bi bi-dash-circle"></i> Liability
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3" id="assetTypeGroup">
                                    <label asp-for="AssetType" class="form-label">Asset Type</label>
                                    <select asp-for="AssetType" class="form-select" asp-items="Html.GetEnumSelectList<AssetType>()">
                                        <option value="">Select asset type</option>
                                    </select>
                                </div>
                                <div class="mb-3" id="liabilityTypeGroup" style="display: none;">
                                    <label asp-for="LiabilityType" class="form-label">Liability Type</label>
                                    <select asp-for="LiabilityType" class="form-select" asp-items="Html.GetEnumSelectList<LiabilityType>()">
                                        <option value="">Select liability type</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="form-check mt-4">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                                        <label class="form-check-label" for="isActiveCheck">
                                            Active in net worth tracking
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Additional details about this item"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Personal notes or reminders"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Back to Net Worth
                                </a>
                                <a href="@Url.Action("History", new { id = Model.Id })" class="btn btn-outline-info">
                                    <i class="bi bi-clock-history"></i> View History
                                </a>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeAsset = document.getElementById('typeAsset');
    const typeLiability = document.getElementById('typeLiability');
    const assetTypeGroup = document.getElementById('assetTypeGroup');
    const liabilityTypeGroup = document.getElementById('liabilityTypeGroup');

    function updateTypeGroups() {
        if (typeAsset.checked) {
            assetTypeGroup.style.display = 'block';
            liabilityTypeGroup.style.display = 'none';
        } else {
            assetTypeGroup.style.display = 'none';
            liabilityTypeGroup.style.display = 'block';
        }
    }

    typeAsset.addEventListener('change', updateTypeGroups);
    typeLiability.addEventListener('change', updateTypeGroups);
    updateTypeGroups();
});
</script>
}
