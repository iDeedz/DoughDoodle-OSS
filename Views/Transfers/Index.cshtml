@model List<DoughDoodle.Models.ScheduledTransfer>
@{
    ViewData["Title"] = "Automated Transfers";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-arrow-left-right text-primary"></i> Automated Transfers</h1>
            <p class="text-muted">Set up and manage automated savings and budget transfers</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Schedule New Transfer
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> You haven't set up any automated transfers yet. Click "Schedule New Transfer" to automate your savings and budget allocations.
        </div>
    }
    else
    {
        <!-- Active Transfers -->
        @if (Model.Any(t => t.IsActive))
        {
            <h4 class="mb-3">Active Transfers</h4>
            <div class="table-responsive mb-4">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>From → To</th>
                            <th>Amount</th>
                            <th>Frequency</th>
                            <th>Next Transfer</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transfer in Model.Where(t => t.IsActive))
                        {
                            <tr>
                                <td>
                                    <strong>@transfer.Name</strong>
                                    @if (!string.IsNullOrEmpty(transfer.Description))
                                    {
                                        <br><small class="text-muted">@transfer.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@(transfer.FromCategory?.Name ?? "Unassigned")</span>
                                    <i class="bi bi-arrow-right"></i>
                                    <span class="badge bg-primary">@(transfer.ToCategory?.Name ?? "Unassigned")</span>
                                </td>
                                <td><strong>@CurrencyDisplay.Format(transfer.Amount, ViewData["PreferredCurrency"] as string)</strong></td>
                                <td>
                                    <span class="badge bg-info">@transfer.Frequency</span>
                                    @if (transfer.AutoExecute)
                                    {
                                        <br><small class="text-success"><i class="bi bi-check-circle"></i> Auto</small>
                                    }
                                </td>
                                <td>
                                    @transfer.NextTransferDate.ToShortDateString()
                                    @if (transfer.NextTransferDate.Date <= DateTime.Now.Date)
                                    {
                                        <br><span class="badge bg-warning">Due Now</span>
                                    }
                                </td>
                                <td>
                                    @if (transfer.TransfersCompleted > 0)
                                    {
                                        <small>@transfer.TransfersCompleted completed</small>
                                    }
                                    @if (transfer.MaxTransfers.HasValue)
                                    {
                                        <br><small>@(transfer.MaxTransfers - transfer.TransfersCompleted) remaining</small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @if (transfer.NextTransferDate.Date <= DateTime.Now.Date && !transfer.AutoExecute)
                                        {
                                            <form asp-action="Execute" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@transfer.Id" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success" onclick="return confirm('Execute this transfer now?')">
                                                    <i class="bi bi-play-circle"></i> Execute
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@transfer.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@transfer.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Delete this transfer?')">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Inactive Transfers -->
        @if (Model.Any(t => !t.IsActive))
        {
            <h4 class="mb-3">Inactive Transfers</h4>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Amount</th>
                            <th>Completed</th>
                            <th>Last Transfer</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transfer in Model.Where(t => !t.IsActive))
                        {
                            <tr class="text-muted">
                                <td>@transfer.Name</td>
                                <td>@CurrencyDisplay.Format(transfer.Amount, ViewData["PreferredCurrency"] as string)</td>
                                <td>@transfer.TransfersCompleted transfers</td>
                                <td>@(transfer.LastTransferDate?.ToShortDateString() ?? "Never")</td>
                                <td>
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@transfer.Id" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this transfer?')">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
