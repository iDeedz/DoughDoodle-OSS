@model DoughDoodle.Models.ViewModels.BillsViewModel
@{
    ViewData["Title"] = "Bill Tracker";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-receipt"></i> Bill Tracker</h2>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add New Bill
                </a>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary">Total Bills</h5>
                    <h3 class="text-primary">@Model.TotalBillsCount</h3>
                    <small class="text-muted">Active bills</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h5 class="card-title text-warning">Upcoming</h5>
                    <h3 class="text-warning">@Model.UpcomingBillsCount</h3>
                    <small class="text-muted">Next 30 days</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <h5 class="card-title text-danger">Overdue</h5>
                    <h3 class="text-danger">@Model.OverdueBillsCount</h3>
                    <small class="text-muted">Need attention</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h5 class="card-title text-success">Monthly Total</h5>
                    <h3 class="text-success">@CurrencyDisplay.Format(Model.TotalMonthlyAmount, ViewData["PreferredCurrency"] as string)</h3>
                    <small class="text-muted">Recurring bills</small>
                </div>
            </div>
        </div>
    </div>

    @if (Model.OverdueBills.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Overdue Bills</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Bill Name</th>
                                        <th>Amount</th>
                                        <th>Due Date</th>
                                        <th>Days Overdue</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bill in Model.OverdueBills)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@bill.Name</strong>
                                                @if (!string.IsNullOrEmpty(bill.Payee))
                                                {
                                                    <br><small class="text-muted">@bill.Payee</small>
                                                }
                                            </td>
                                            <td>@CurrencyDisplay.Format(bill.Amount, ViewData["PreferredCurrency"] as string)</td>
                                            <td>@bill.DueDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-danger">
                                                    @((DateTime.Now.Date - bill.DueDate.Date).Days) days
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-success" onclick="markPaid(@bill.Id, '@bill.Name', @bill.Amount)">
                                                    <i class="bi bi-check"></i> Mark Paid
                                                </button>
                                                <a href="@Url.Action("Edit", new { id = bill.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.UpcomingBills.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Upcoming Bills (Next 30 Days)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Bill Name</th>
                                        <th>Amount</th>
                                        <th>Due Date</th>
                                        <th>Days Until Due</th>
                                        <th>Category</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bill in Model.UpcomingBills)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@bill.Name</strong>
                                                @if (!string.IsNullOrEmpty(bill.Payee))
                                                {
                                                    <br><small class="text-muted">@bill.Payee</small>
                                                }
                                            </td>
                                            <td>@CurrencyDisplay.Format(bill.Amount, ViewData["PreferredCurrency"] as string)</td>
                                            <td>@bill.DueDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @{
                                                    var daysUntilDue = (bill.DueDate.Date - DateTime.Now.Date).Days;
                                                    var badgeClass = daysUntilDue <= 3 ? "bg-danger" : daysUntilDue <= 7 ? "bg-warning" : "bg-success";
                                                }
                                                <span class="badge @badgeClass">
                                                    @daysUntilDue days
                                                </span>
                                            </td>
                                            <td>
                                                @if (bill.Category != null)
                                                {
                                                    <span class="badge bg-secondary">@bill.Category.Name</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No Category</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-success" onclick="markPaid(@bill.Id, '@bill.Name', @bill.Amount)">
                                                    <i class="bi bi-check"></i> Mark Paid
                                                </button>
                                                <a href="@Url.Action("Edit", new { id = bill.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- All Bills -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-list"></i> All Bills</h5>
                </div>
                <div class="card-body">
                    @if (Model.AllBills.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped" id="billsTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Amount</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                        <th>Recurrence</th>
                                        <th>Category</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bill in Model.AllBills)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@bill.Name</strong>
                                                @if (!string.IsNullOrEmpty(bill.Payee))
                                                {
                                                    <br><small class="text-muted">@bill.Payee</small>
                                                }
                                            </td>
                                            <td>@CurrencyDisplay.Format(bill.Amount, ViewData["PreferredCurrency"] as string)</td>
                                            <td>@bill.DueDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @{
                                                    var statusClass = bill.Status switch
                                                    {
                                                        DoughDoodle.Models.BillStatus.Paid => "bg-success",
                                                        DoughDoodle.Models.BillStatus.Overdue => "bg-danger",
                                                        DoughDoodle.Models.BillStatus.Pending => "bg-warning",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @statusClass">@bill.Status</span>
                                            </td>
                                            <td>
                                                @if (bill.IsRecurring)
                                                {
                                                    <span class="badge bg-info">@bill.Recurrence</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">One-time</span>
                                                }
                                            </td>
                                            <td>
                                                @if (bill.Category != null)
                                                {
                                                    <span class="badge bg-secondary">@bill.Category.Name</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No Category</span>
                                                }
                                            </td>
                                            <td>
                                                @if (bill.Status != DoughDoodle.Models.BillStatus.Paid)
                                                {
                                                    <button class="btn btn-sm btn-success" onclick="markPaid(@bill.Id, '@bill.Name', @bill.Amount)">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                }
                                                <a href="@Url.Action("Edit", new { id = bill.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="@Url.Action("PaymentHistory", new { id = bill.Id })" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-clock-history"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteBill(@bill.Id, '@bill.Name')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-receipt display-1 text-muted"></i>
                            <h4 class="text-muted mt-3">No Bills Yet</h4>
                            <p class="text-muted">Add your first bill to start tracking payments and due dates.</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Add Your First Bill
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mark Paid Modal -->
<div class="modal fade" id="markPaidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark Bill as Paid</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="markPaidForm">
                    <input type="hidden" id="billId" />
                    <div class="mb-3">
                        <label for="billName" class="form-label">Bill Name</label>
                        <input type="text" class="form-control" id="billName" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="amountPaid" class="form-label">Amount Paid</label>
                        <input type="number" step="0.01" class="form-control" id="amountPaid" required />
                    </div>
                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label">Payment Method</label>
                        <select class="form-control" id="paymentMethod">
                            <option value="Online">Online</option>
                            <option value="Check">Check</option>
                            <option value="Cash">Cash</option>
                            <option value="Auto-Pay">Auto-Pay</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="paymentNotes" class="form-label">Notes (Optional)</label>
                        <textarea class="form-control" id="paymentNotes" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitMarkPaid()">Mark as Paid</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function markPaid(billId, billName, amount) {
    document.getElementById('billId').value = billId;
    document.getElementById('billName').value = billName;
    document.getElementById('amountPaid').value = amount;
    
    var modal = new bootstrap.Modal(document.getElementById('markPaidModal'));
    modal.show();
}

function submitMarkPaid() {
    const billId = document.getElementById('billId').value;
    const amountPaid = document.getElementById('amountPaid').value;
    const paymentMethod = document.getElementById('paymentMethod').value;
    const notes = document.getElementById('paymentNotes').value;
    
    if (!amountPaid || amountPaid <= 0) {
        alert('Please enter a valid amount paid.');
        return;
    }
    
    fetch('@Url.Action("MarkPaid")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify({
            id: billId,
            amountPaid: parseFloat(amountPaid),
            paymentMethod: paymentMethod,
            notes: notes
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error marking bill as paid. Please try again.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error marking bill as paid. Please try again.');
    });
}

function deleteBill(billId, billName) {
    if (confirm(`Are you sure you want to delete the bill "${billName}"?`)) {
        fetch('@Url.Action("Delete")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ id: billId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error deleting bill. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error deleting bill. Please try again.');
        });
    }
}

// Initialize DataTable if bills exist
@if (Model.AllBills.Any())
{
    <text>
    $(document).ready(function() {
        $('#billsTable').DataTable({
            "pageLength": 25,
            "order": [[ 2, "asc" ]], // Sort by due date
            "responsive": true
        });
    });
    </text>
}
</script>
}